		"scene:add": "tsx src/scene-add.ts",
		"scene:list": "tsx src/scene-list.ts",
		"scene:remove": "tsx src/scene-remove.ts",
		"cut": "tsx src/cut.ts",
		"analyze:silences": "tsx src/analyze-silences.ts",
		"analyze:cursor": "tsx src/analyze-cursor.ts",
		"analyze:clicks": "tsx src/analyze-clicks.ts",
		"analyze:transitions": "tsx src/analyze-transitions.ts",
		"analyze:transcript": "tsx src/analyze-transcript.ts",
		"audio:sanitize": "tsx src/audio-sanitize.ts",
		"audio:extract-speaker": "tsx src/audio-extract-speaker.ts",
